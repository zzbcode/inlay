{
  "name": "inlay",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "夹层 Inlay · 所有文件皆可隐藏｜本地文件隐藏、文件拼接与无损提取 · Local-first file hider",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.cjs",
    "start": "node scripts/preview.mjs",
    "test:browser": "playwright test --config tests/playwright.config.cjs",
    "format": "prettier --write src/*.js src/*.html src/*.css scripts/*.mjs tests/*.cjs tests/browser/*.cjs",
    "format:check": "prettier --check src/*.js src/*.html src/*.css",
    "release": "node scripts/release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zzbcode/inlay.git"
  },
  "homepage": "https://82.156.103.223/inlay/",
  "bugs": {
    "url": "https://github.com/zzbcode/inlay/issues"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  },
  "keywords": [
    "file-hiding",
    "file-hider",
    "data-hiding",
    "file-concatenation",
    "steganography",
    "local-first",
    "offline-first",
    "client-side",
    "sha256",
    "python"
  ]
}
